#!/usr/bin/env php
<?php

declare(strict_types=1);

use Infocyph\PHPProbe\Console\Cli;

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;

        break;
    }
}

if (!class_exists(Cli::class)) {
    fwrite(STDERR, 'PHPProbe autoloader not found. Install the package with Composer.' . PHP_EOL);

    exit(2);
}

exit((new Cli())->run($argv));
