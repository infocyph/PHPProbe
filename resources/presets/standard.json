{
  "syntax": {
    "exclude": [
      "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ]
  },
  "reference": {
    "exclude": [
      "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ]
  },
  "duplicates": {
    "exclude": [
      "tests", "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ],
    "mode": "audit",
    "normalize": true,
    "fuzzy": true,
    "near_miss": true,
    "min_lines": 5,
    "min_tokens": 90,
    "min_statements": 4,
    "min_similarity": 0.85
  },
  "comments": {
    "exclude": [
      "tests", "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ]
  },
  "commented_out_code": {
    "policy": "standard",
    "min_reason_length": 20,
    "max_allowed_block_lines": 8,
    "require_issue_for_blocks_longer_than": 5
  }
}
