{
  "syntax": {
    "exclude": [
      "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ],
    "parallel": 2
  },
  "duplicates": {
    "exclude": [
      "tests", "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ],
    "mode": "audit",
    "fuzzy": true,
    "near_miss": true,
    "min_lines": 4,
    "min_tokens": 70,
    "min_statements": 3,
    "min_similarity": 0.8
  },
  "comments": {
    "exclude": [
      "tests", "vendor", "node_modules", ".git", ".idea", ".vscode", "coverage",
      ".phpunit.cache", ".psalm-cache", "build", "dist", "tmp", ".tmp",
      "storage", "bootstrap/cache", "var/cache"
    ]
  },
  "commented_out_code": {
    "policy": "strict",
    "min_reason_length": 24,
    "max_allowed_block_lines": 6,
    "require_issue_for_blocks_longer_than": 4
  }
}
